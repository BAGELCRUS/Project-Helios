FrameWidgetClass {
 Name "rootFrame"
 Slot LayoutSlot "{A1B2C3D4E5F60002}" {
  HorizontalAlign 1
  VerticalAlign 1
 }
 {
  ImageWidgetClass "{A1B2C3D4E5F60003}" {
   Name "BackgroundDim"
   Slot FrameWidgetSlot "{A1B2C3D4E5F60004}" {
    PositionX 0
    OffsetLeft 0
    PositionY 0
    OffsetTop 0
    SizeX 1920
    OffsetRight -1920
    SizeY 1080
    OffsetBottom -1080
   }
   Color 0 0 0 0.75
  }
  OverlayWidgetClass "{A1B2C3D4E5F60005}" {
   Name "OverlayPanel"
   Slot FrameWidgetSlot "{A1B2C3D4E5F60006}" {
    Anchor 0.5 0.5 0.5 0.5
    PositionX -400
    OffsetLeft -400
    PositionY -300
    OffsetTop -300
    SizeX 800
    OffsetRight -400
    SizeY 600
    OffsetBottom -300
   }
   {
    ImageWidgetClass "{A1B2C3D4E5F60007}" {
     Name "PanelBackground"
     Slot OverlayWidgetSlot "{A1B2C3D4E5F60008}" {
      HorizontalAlign 0
      VerticalAlign 0
     }
     Color 0.05 0.05 0.08 0.92
    }
    ImageWidgetClass "{A1B2C3D4E5F60009}" {
     Name "PanelBorder"
     Slot OverlayWidgetSlot "{A1B2C3D4E5F6000A}" {
      HorizontalAlign 0
      VerticalAlign 0
      Padding -2 -2 -2 -2
     }
     Color 0.3 0.3 0.35 0.6
    }
    TextWidgetClass "{A1B2C3D4E5F6000B}" {
     Name "TitleText"
     Slot OverlayWidgetSlot "{A1B2C3D4E5F6000C}" {
      HorizontalAlign 0
      VerticalAlign 0
      Padding 30 20 30 0
     }
     Text "INTEL TITLE"
     "Exact Font Size" 28
     "Horizontal Alignment" Center
     "Vertical Alignment" Center
     Color 0.9 0.85 0.7 1
    }
    ImageWidgetClass "{A1B2C3D4E5F6000D}" {
     Name "TitleSeparator"
     Slot OverlayWidgetSlot "{A1B2C3D4E5F6000E}" {
      HorizontalAlign 0
      VerticalAlign 0
      Padding 30 78 30 0
     }
     Color 0.4 0.4 0.45 0.5
    }
    RichTextWidgetClass "{A1B2C3D4E5F6000F}" {
     Name "DescriptionText"
     Slot OverlayWidgetSlot "{A1B2C3D4E5F60010}" {
      HorizontalAlign 0
      VerticalAlign 0
      Padding 30 100 30 60
     }
     Text "Intel description text goes here..."
     "Exact Font Size" 18
     Wrap 1
     Color 0.8 0.8 0.8 1
    }
    TextWidgetClass "{A1B2C3D4E5F60011}" {
     Name "CloseHintText"
     Slot OverlayWidgetSlot "{A1B2C3D4E5F60012}" {
      HorizontalAlign 0
      VerticalAlign 2
      Padding 30 0 0 20
     }
     Text "[ESC] Close"
     "Exact Font Size" 16
     "Vertical Alignment" Center
     Color 0.5 0.5 0.5 1
    }
   }
  }
 }
}